<?xml version="1.0" encoding="utf-8"?>
<!-- Ducky's tap menu, drawn as a speech bubble pointing at the duck. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/menuContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Open to-dos, tickable right here -->
        <LinearLayout
            android:id="@+id/menuTodos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView android:id="@+id/menuDone" style="@style/MenuIcon" android:contentDescription="@string/menu_done" android:text="✅" />
            <TextView android:id="@+id/menuSnooze" style="@style/MenuIcon" android:contentDescription="@string/menu_snooze" android:text="😴" />
            <TextView android:id="@+id/menuAdd" style="@style/MenuIcon" android:contentDescription="@string/menu_alarm" android:text="⏰" />
            <TextView android:id="@+id/menuTodo" style="@style/MenuIcon" android:contentDescription="@string/menu_todo" android:text="📝" />
            <TextView android:id="@+id/menuSettings" style="@style/MenuIcon" android:contentDescription="@string/menu_settings" android:text="⚙️" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
