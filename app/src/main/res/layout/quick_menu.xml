<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="32dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView android:id="@+id/menuDone" style="@style/MenuIcon" android:contentDescription="@string/menu_done" android:text="✅" />
            <TextView android:id="@+id/menuSnooze" style="@style/MenuIcon" android:contentDescription="@string/menu_snooze" android:text="😴" />
            <TextView android:id="@+id/menuAdd" style="@style/MenuIcon" android:contentDescription="@string/menu_alarm" android:text="⏰" />
            <TextView android:id="@+id/menuTodo" style="@style/MenuIcon" android:contentDescription="@string/menu_todo" android:text="📝" />
            <TextView android:id="@+id/menuSettings" style="@style/MenuIcon" android:contentDescription="@string/menu_settings" android:text="⚙️" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
