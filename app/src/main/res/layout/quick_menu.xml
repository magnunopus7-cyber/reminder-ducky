<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="32dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView android:id="@+id/menuDone" style="@style/MenuIcon" android:contentDescription="Mark as done" android:text="✅" />
            <TextView android:id="@+id/menuSnooze" style="@style/MenuIcon" android:contentDescription="Snooze 10 minutes" android:text="⏰" />
            <TextView android:id="@+id/menuAdd" style="@style/MenuIcon" android:contentDescription="Add a reminder" android:text="➕" />
            <TextView android:id="@+id/menuList" style="@style/MenuIcon" android:contentDescription="View all reminders" android:text="📋" />
            <TextView android:id="@+id/menuCustomize" style="@style/MenuIcon" android:contentDescription="Customize Ducky" android:text="🎨" />
            <TextView android:id="@+id/menuHide" style="@style/MenuIcon" android:contentDescription="Hide Ducky for now" android:text="🙈" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
