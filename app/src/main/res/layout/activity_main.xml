<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Sky header with the live duck -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_header"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_title"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/previewHolder"
                    android:layout_width="96dp"
                    android:layout_height="96dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <!-- Permissions -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/setup_title" />

                    <TextView
                        style="@style/SectionSub"
                        android:text="@string/setup_help" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_overlay" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_notif" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_exact" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBattery"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_battery" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reminders -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/your_reminders" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/emptyText"
                        style="@style/SectionSub"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/empty" />

                    <LinearLayout
                        android:id="@+id/listContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTest"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/try_it" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Skins -->
            <TextView
                style="@style/SectionTitle"
                android:layout_marginStart="4dp"
                android:text="@string/skins_title" />

            <TextView
                style="@style/SectionSub"
                android:layout_marginStart="4dp"
                android:text="@string/skins_sub" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginBottom="16dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/skinRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Customize -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/customizeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/customize_title" />

                    <TextView
                        style="@style/SectionSub"
                        android:text="@string/customize_sub" />

                    <TextView style="@style/FieldLabel" android:text="@string/label_material" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/materialGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView style="@style/FieldLabel" android:text="@string/label_colour" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/colorRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp" />
                    </HorizontalScrollView>

                    <TextView style="@style/FieldLabel" android:text="@string/label_accessory" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/accessoryGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView style="@style/FieldLabel" android:text="@string/label_size" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/sizeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView style="@style/FieldLabel" android:text="@string/label_language" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/languageGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDuck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/show_duck"
                        android:textColor="@color/ink" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchQuack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_quack"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
