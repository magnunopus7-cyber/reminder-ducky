<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Sky header with the live duck -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_header"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_title"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/previewHolder"
                    android:layout_width="96dp"
                    android:layout_height="96dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <!-- Each card folds open and closed from its title row. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/setupCardHead"
                        style="@style/FoldHeader">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/setup_title" />

                        <ImageView
                            android:id="@+id/setupCardChevron"
                            style="@style/FoldChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/setupCardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="6dp"
                        android:paddingBottom="8dp">

                        <TextView
                            style="@style/SectionSub"
                            android:text="@string/setup_help" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_overlay" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNotif"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_notif" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_exact" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBattery"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_battery" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/remindersCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/remindersCardHead"
                        style="@style/FoldHeader">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/your_reminders" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdd"
                            app:backgroundTint="@color/plus_blue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/add" />

                        <ImageView
                            android:id="@+id/remindersCardChevron"
                            style="@style/FoldChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remindersCardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="6dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/emptyText"
                            style="@style/SectionSub"
                            android:gravity="center"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/empty" />

                        <LinearLayout
                            android:id="@+id/listContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTest"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/try_it" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/todoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/todoCardHead"
                        style="@style/FoldHeader">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/todo_title" />

                        <ImageView
                            android:id="@+id/todoCardChevron"
                            style="@style/FoldChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/todoCardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="6dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/todoInput"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/pill_input"
                                android:hint="@string/todo_hint"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="textCapSentences"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/ink_soft"
                                android:textSize="16sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/todoAdd"
                            app:backgroundTint="@color/plus_blue"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="24dp"
                                android:layout_marginStart="8dp"
                                android:text="@string/add" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/todoEmpty"
                            style="@style/SectionSub"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:text="@string/todo_empty" />

                        <LinearLayout
                            android:id="@+id/todoList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/todoClear"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="@string/todo_clear" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/skinsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/skinsCardHead"
                        style="@style/FoldHeader">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/skins_title" />

                        <ImageView
                            android:id="@+id/skinsCardChevron"
                            style="@style/FoldChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/skinsCardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="6dp"
                        android:paddingBottom="8dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/colorRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/customizeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/customizeCardHead"
                        style="@style/FoldHeader">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/customize_title" />

                        <ImageView
                            android:id="@+id/customizeCardChevron"
                            style="@style/FoldChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/customizeCardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="6dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:id="@+id/materialHead"
                            style="@style/FoldHeader"
                            android:layout_marginTop="4dp">

                            <TextView
                                style="@style/FieldLabel"
                                android:layout_width="0dp"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/label_material" />

                            <TextView
                                android:id="@+id/materialValue"
                                style="@style/FoldValue" />

                            <ImageView
                                android:id="@+id/materialChevron"
                                style="@style/FoldChevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/materialBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <HorizontalScrollView style="@style/OptionScroll">

                                <LinearLayout
                                    android:id="@+id/materialRow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp" />
                            </HorizontalScrollView>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/accessoryHead"
                            style="@style/FoldHeader"
                            android:layout_marginTop="4dp">

                            <TextView
                                style="@style/FieldLabel"
                                android:layout_width="0dp"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/label_accessory" />

                            <TextView
                                android:id="@+id/accessoryValue"
                                style="@style/FoldValue" />

                            <ImageView
                                android:id="@+id/accessoryChevron"
                                style="@style/FoldChevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/accessoryBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Many accessories: they wrap onto rows instead of scrolling sideways. -->
                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/accessoryRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/toneHead"
                            style="@style/FoldHeader"
                            android:layout_marginTop="4dp">

                            <TextView
                                style="@style/FieldLabel"
                                android:layout_width="0dp"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/label_tone" />

                            <TextView
                                android:id="@+id/toneValue"
                                style="@style/FoldValue" />

                            <ImageView
                                android:id="@+id/toneChevron"
                                style="@style/FoldChevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/toneBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/toneGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <!-- A sample of how Ducky talks in the chosen tone. -->
                            <TextView
                                android:id="@+id/toneSample"
                                style="@style/SectionSub"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/sizeHead"
                            style="@style/FoldHeader"
                            android:layout_marginTop="4dp">

                            <TextView
                                style="@style/FieldLabel"
                                android:layout_width="0dp"
                                android:layout_marginTop="0dp"
                                android:layout_weight="1"
                                android:text="@string/label_size" />

                            <TextView
                                android:id="@+id/sizeValue"
                                style="@style/FoldValue" />

                            <ImageView
                                android:id="@+id/sizeChevron"
                                style="@style/FoldChevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/sizeBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <HorizontalScrollView style="@style/OptionScroll">

                                <LinearLayout
                                    android:id="@+id/sizeRow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:paddingTop="4dp"
                                    android:paddingBottom="4dp" />
                            </HorizontalScrollView>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDuck"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/show_duck"
                            android:textColor="@color/ink" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchQuack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tap_quack"
                            android:textColor="@color/ink" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/languageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/languageHead"
                        style="@style/FoldHeader">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/label_language" />

                        <TextView
                            android:id="@+id/languageValue"
                            style="@style/FoldValue" />

                        <ImageView
                            android:id="@+id/languageChevron"
                            style="@style/FoldChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/languageBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="6dp"
                        android:paddingBottom="8dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/languageGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/done_page" />

            <TextView
                style="@style/SectionSub"
                android:gravity="center"
                android:text="@string/autosave_note" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
