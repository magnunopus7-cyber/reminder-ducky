<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Sky header with the live duck -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sky_header"
            android:fitsSystemWindows="true">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-10dp"
                android:layout_marginBottom="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cloud" />

            <ImageView
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="120dp"
                android:importantForAccessibility="no"
                android:src="@drawable/cloud" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="8dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ducky 💛"
                        android:textColor="#FFFFFF"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your little reminder buddy"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Floats over your apps, keeps you on track and makes every day a little more joyful. Tap me!"
                        android:textColor="#F2FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/previewHolder"
                    android:layout_width="150dp"
                    android:layout_height="150dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <!-- Permissions -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Let Ducky move in 🏡" />

                    <TextView
                        style="@style/SectionSub"
                        android:text="Tap each button. Android opens a settings page: switch it on, then come back here." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Let Ducky float over other apps" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Allow notifications" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Allow reminders at the exact time" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBattery"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Don't let battery saver put Ducky to sleep" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reminders -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Your reminders" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Add" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/emptyText"
                        style="@style/SectionSub"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp"
                        android:text="No reminders yet. Tap + Add, or tap the floating Ducky any time." />

                    <LinearLayout
                        android:id="@+id/listContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTest"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Try it: remind me in 1 minute" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Skins -->
            <TextView
                style="@style/SectionTitle"
                android:layout_marginStart="4dp"
                android:text="Collectible Ducky skins" />

            <TextView
                style="@style/SectionSub"
                android:layout_marginStart="4dp"
                android:text="Choose your favourite look, or collect them all!" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginBottom="16dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/skinRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Customize -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/customizeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Customize your duck" />

                    <TextView
                        style="@style/SectionSub"
                        android:text="Change the material, colour and accessories any time." />

                    <TextView style="@style/FieldLabel" android:text="Material" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/materialGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView style="@style/FieldLabel" android:text="Colour" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/colorRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp" />
                    </HorizontalScrollView>

                    <TextView style="@style/FieldLabel" android:text="Accessory" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/accessoryGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <TextView style="@style/FieldLabel" android:text="Size" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/sizeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDuck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Show Ducky over other apps"
                        android:textColor="@color/ink" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchQuack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quack when I tap Ducky"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
