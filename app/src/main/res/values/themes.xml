<resources>
    <style name="Theme.ReminderDucky" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#2F7BF5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D8E8FF</item>
        <item name="colorOnPrimaryContainer">#0B2A5C</item>
        <item name="colorSecondaryContainer">#FFE8A3</item>
        <item name="colorOnSecondaryContainer">#3A2A00</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="materialCardViewStyle">@style/DuckCard</item>
    </style>

    <style name="DuckCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="SectionSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
